<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported so adb can reach it; requires DUMP, which only the shell (adb) holds. Never in release. -->
        <receiver
            android:name=".kiosk.DebugKioskExitReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.rihal.roompanel.EXIT_KIOSK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
